{
  "manifest_version": 3,
  "name": "Visibility & Focus Disabler",
  "version": "1.0",
  "description": "Подменяет visibilityState и блокирует события blur/focus.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}